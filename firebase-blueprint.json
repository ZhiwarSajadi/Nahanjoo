{
  "entities": {
    "UserActivityLog": {
      "title": "UserActivityLog",
      "description": "Records user login and analysis events",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "eventType": {
          "type": "string",
          "enum": ["LOGIN", "ANALYSIS"]
        },
        "timestamp": {
          "type": "timestamp"
        },
        "details": {
          "type": "string"
        }
      },
      "required": ["userId", "eventType", "timestamp"]
    }
  },
  "firestore": {
    "userActivityLogs/{logId}": {
      "schema": {
        "$ref": "UserActivityLog"
      },
      "description": "Logs of user actions. Users can only create their own logs and read their own logs."
    }
  }
}
